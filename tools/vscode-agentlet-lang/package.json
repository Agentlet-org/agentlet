{
  "name": "vscode-agentlet-lang",
  "displayName": "Agentlet Language Support",
  "description": "Syntax highlighting and snippets for Agentlet agent files",
  "version": "0.1.0",
  "publisher": "agentlet",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "agentlet",
    "ai-agent",
    "html"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Agentlet-org/agentlet"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:agentlet"
  ],
  "contributes": {
    "languages": [
      {
        "id": "agentlet",
        "aliases": [
          "Agentlet",
          "agentlet"
        ],
        "extensions": [
          ".agentlet"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "agentlet",
        "scopeName": "text.html.agentlet",
        "path": "./syntaxes/agentlet.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "agentlet",
        "path": "./snippets/agentlet.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
