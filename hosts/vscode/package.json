{
  "name": "vscode-agentlet",
  "displayName": "Agentlet",
  "description": "Run portable AI agents in VS Code",
  "version": "0.1.0",
  "publisher": "agentlet",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "agentlet",
    "ai-agents",
    "ai",
    "automation"
  ],
  "activationEvents": [
    "onView:agentlet.agents",
    "onCommand:agentlet.installFromUrl",
    "onCommand:agentlet.runAction"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentlet",
          "title": "Agentlet",
          "icon": "resources/icons/agentlet.svg"
        }
      ]
    },
    "views": {
      "agentlet": [
        {
          "id": "agentlet.agents",
          "name": "Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "agentlet.installFromUrl",
        "title": "Install Agent from URL",
        "category": "Agentlet",
        "icon": "$(add)"
      },
      {
        "command": "agentlet.refreshAgents",
        "title": "Refresh Agents",
        "category": "Agentlet",
        "icon": "$(refresh)"
      },
      {
        "command": "agentlet.uninstall",
        "title": "Uninstall Agent",
        "category": "Agentlet"
      },
      {
        "command": "agentlet.viewSource",
        "title": "View Agent Source",
        "category": "Agentlet"
      },
      {
        "command": "agentlet.runAction",
        "title": "Run Agent Action",
        "category": "Agentlet"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentlet.installFromUrl",
          "when": "view == agentlet.agents",
          "group": "navigation"
        },
        {
          "command": "agentlet.refreshAgents",
          "when": "view == agentlet.agents",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentlet.uninstall",
          "when": "view == agentlet.agents && viewItem == agent"
        },
        {
          "command": "agentlet.viewSource",
          "when": "view == agentlet.agents && viewItem == agent"
        }
      ]
    },
    "configuration": {
      "title": "Agentlet",
      "properties": {
        "agentlet.inference.provider": {
          "type": "string",
          "default": "ollama",
          "enum": ["ollama", "openai"],
          "enumDescriptions": [
            "Use local Ollama server",
            "Use OpenAI API"
          ],
          "description": "Inference provider for AI agents"
        },
        "agentlet.inference.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL"
        },
        "agentlet.inference.ollamaModel": {
          "type": "string",
          "default": "llama3.2",
          "description": "Ollama model to use for inference"
        },
        "agentlet.inference.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model to use for inference"
        },
        "agentlet.inference.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key (or set OPENAI_API_KEY environment variable)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@agentlet/host-sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
